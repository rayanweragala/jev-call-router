TYPESAFE_API_KEY=
# Optional: override default model (jev-latest).
# TYPESAFE_DEFAULT_MODEL=

# Speech-to-text (required). Any service exposing POST {STT_BASE_URL}/audio/transcriptions
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=
# Optional: ISO-639-1 language hint, e.g. en
# STT_LANGUAGE=

# Asterisk REST Interface (required for `bun start`).
ARI_URL=http://127.0.0.1:8088
ARI_USERNAME=
ARI_PASSWORD=
ARI_APP=jev-router

# Optional: required only when router.config.ts enables the Claude interpreter.
# ANTHROPIC_API_KEY=

# Optional: outbound webhook for call routing outcomes (HTTP POST)
# WEBHOOK_URL=https://your-crm.example.com/api/webhooks/call-routed
# WEBHOOK_SECRET=your-webhook-signing-secret

# Optional: HTTP visualizer & SSE port (default 3000)
# PORT=3000
